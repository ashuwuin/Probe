# Probe Environment Configuration Template
# Copy this file to .env and fill in your values (never commit .env!)

# GitHub App Authentication
GITHUB_APP_ID=your_github_app_id_here
GITHUB_PRIVATE_KEY_PATH=secrets/probe-app.private-key.pem
GITHUB_WEBHOOK_SECRET=your_webhook_secret_here

# Bot Identity and Permissions
PROBE_BOT_LOGIN=probe[bot]
PROBE_APPLY_LABELS=false
PROBE_MAX_CONCURRENT_JOBS=2

# Local AI Engine Settings (Defaults to local Ollama - no keys needed)
MODEL_BASE_URL=http://localhost:11434/v1
MODEL_NAME=qwen3:8b
